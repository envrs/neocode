{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@neocode-ai/tool-tsconfig/bun",
  "compilerOptions": {
    "outDir": "dist",
    "module": "nodenext",
    "declaration": true,
    "moduleResolution": "nodenext",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": [
    "src",
    "script",
    "package.json"
  ]
}